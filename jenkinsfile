pipeline {
    agent any

    environment {
        REGION = 'ap-south-1'
        ACCOUNT = '476603352136'
        ECR_REPO = 'bhavya-zomato'
        EKS_CLUSTER = 'task8-eks-cluster'
        IMAGE = "${ACCOUNT}.dkr.ecr.${REGION}.amazonaws.com/${ECR_REPO}:${BUILD_NUMBER}"
    }

    stages {

        stage('Install Tools') {
            steps {
                sh '''
                    echo "Installing Git..."
                    sudo dnf install -y git

                    echo "Installing Docker..."
                    sudo dnf install -y docker
                    sudo systemctl enable --now docker
                    sudo docker --version

                    echo "Installing AWS CLI..."
                    if ! command -v aws >/dev/null; then
                        sudo dnf install -y unzip
                        curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o aws.zip
                        unzip -q aws.zip
                        sudo ./aws/install
                        rm -rf aws aws.zip
                    fi
                    aws --version

                    echo "Installing Node.js..."
                    if ! command -v node >/dev/null; then
                        curl -fsSL https://rpm.nodesource.com/setup_20.x | sudo bash -
                        sudo dnf install -y nodejs
                    fi
                    node -v
                    npm -v

                    echo "Installing kubectl..."
                    if ! command -v kubectl >/dev/null; then
                        curl -LO "https://dl.k8s.io/release/$(curl -Ls https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
                        sudo install -m 0755 kubectl /usr/local/bin/kubectl
                        rm kubectl
                    fi
                    kubectl version --client

                    echo "Installing eksctl..."
                    if ! command -v eksctl >/dev/null; then
                        curl -sL "https://github.com/eksctl-io/eksctl/releases/latest/download/eksctl_Linux_amd64.tar.gz" | tar xz -C /tmp
                        sudo mv /tmp/eksctl /usr/local/bin/
                    fi
                    eksctl version
                '''
            }
        }

        stage('Clone & Build') {
            steps {
                sh '''
                    rm -rf application
                    git clone -b task8-eks \
                    https://github.com/Bhavyakotrike/task6-terraform.git application

                    cd application
                    npm install
                    npm run build
                '''
            }
        }

        stage('Docker Build & ECR') {
            steps {
                sh '''
                    cd application

                    echo "Building Docker image..."
                    sudo docker build -t bhavya-zomato:${BUILD_NUMBER} .

                    echo "Creating ECR repository..."
                    aws ecr describe-repositories \
                        --repository-names ${ECR_REPO} \
                        --region ${REGION} >/dev/null 2>&1 || \
                    aws ecr create-repository \
                        --repository-name ${ECR_REPO} \
                        --region ${REGION}

                    echo "Login to ECR..."
                    aws ecr get-login-password --region ${REGION} | \
                    sudo docker login --username AWS --password-stdin \
                    ${ACCOUNT}.dkr.ecr.${REGION}.amazonaws.com

                    sudo docker tag \
                        bhavya-zomato:${BUILD_NUMBER} ${IMAGE}

                    echo "Pushing image..."
                    sudo docker push ${IMAGE}
                '''
            }
        }

        stage('Create EKS') {
            steps {
                sh '''
                    if eksctl get cluster --name ${EKS_CLUSTER} \
                        --region ${REGION} >/dev/null 2>&1; then

                        echo "EKS cluster already exists."

                    else
                        echo "Creating EKS cluster..."

                        eksctl create cluster \
                            --name ${EKS_CLUSTER} \
                            --region ${REGION} \
                            --nodegroup-name task8-nodes \
                            --node-type t3.medium \
                            --nodes 2 \
                            --nodes-min 2 \
                            --nodes-max 2 \
                            --managed
                    fi

                    aws eks update-kubeconfig \
                        --region ${REGION} \
                        --name ${EKS_CLUSTER}

                    kubectl get nodes -o wide
                '''
            }
        }

        stage('Deploy Application') {
            steps {
                sh '''
                    cd application

                    echo "Updating deployment image..."
                    sed "s|IMAGE_PLACEHOLDER|${IMAGE}|g" \
                        Kubernetes/deployment.yaml > /tmp/deployment.yaml

                    echo "Applying Deployment..."
                    kubectl apply -f /tmp/deployment.yaml

                    echo "Applying LoadBalancer Service..."
                    kubectl apply -f Kubernetes/service.yaml

                    kubectl rollout status deployment/zomato \
                        --timeout=180s
                '''
            }
        }

        stage('Verify') {
            steps {
                sh '''
                    echo "===== NODES ====="
                    kubectl get nodes -o wide

                    echo "===== PODS ====="
                    kubectl get pods -o wide

                    echo "===== DEPLOYMENT ====="
                    kubectl get deployment zomato

                    echo "===== SERVICE ====="
                    kubectl get svc zomato

                    echo "Waiting for Load Balancer..."

                    for i in {1..30}; do
                        LB=$(kubectl get svc zomato \
                            -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' \
                            2>/dev/null || true)

                        [ -n "$LB" ] && break
                        sleep 10
                    done

                    if [ -z "$LB" ]; then
                        echo "Load Balancer not ready."
                        exit 1
                    fi

                    echo "================================"
                    echo "APPLICATION URL"
                    echo "http://${LB}:3000"
                    echo "================================"

                    curl -fsS --max-time 10 \
                        "http://${LB}:3000" >/dev/null && \
                        echo "Application is UP!"
                '''
            }
        }
    }

    post {
        success {
            echo 'Task 8 deployment completed successfully.'
        }
        failure {
            echo 'Task 8 deployment failed. Check console output.'
        }
    }
}
