pipeline {
    agent any

    tools {
        jdk 'jdk21'
        nodejs 'node23'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
        TMPDIR = '/home/ec2-user/trivy-tmp'
        TRIVY_CACHE_DIR = '/home/ec2-user/trivy-cache'
    }

    stages {

        stage('Clone Git Repository') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Bhavyakotrike/task6-terraform.git'
            }
        }

        stage('Verify Code') {
            steps {
                sh '''
                    echo "===== Java Version ====="
                    java -version

                    echo "===== Node Version ====="
                    node --version

                    echo "===== NPM Version ====="
                    npm --version

                    echo "===== Git Version ====="
                    git --version

                    echo "===== Docker Version ====="
                    docker --version

                    echo "===== Trivy Version ====="
                    trivy --version

                    echo "===== Project Files ====="
                    ls -la
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh '''
                        $SCANNER_HOME/bin/sonar-scanner \
                        -Dsonar.projectName=task6-zomato \
                        -Dsonar.projectKey=task6-zomato
                    '''
                }
            }
        }

        stage('Install NPM Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                dependencyCheck(
                    additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit --noupdate',
                    odcInstallation: 'DP-Check',
                    nvdCredentialsId: 'nvdapikey'
                )

                dependencyCheckPublisher(
                    pattern: '**/dependency-check-report.xml'
                )
            }
        }

        stage('Trivy File Scan') {
            steps {
                sh '''
                    mkdir -p "$TMPDIR"
                    mkdir -p "$TRIVY_CACHE_DIR"

                    trivy fs \
                    --scanners vuln \
                    --cache-dir "$TRIVY_CACHE_DIR" \
                    . > trivy-fs.txt
                '''
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build -t task6-zomato .
                '''
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    mkdir -p "$TMPDIR"
                    mkdir -p "$TRIVY_CACHE_DIR"

                    trivy image \
                    --scanners vuln \
                    --cache-dir "$TRIVY_CACHE_DIR" \
                    task6-zomato > trivy-image.txt
                '''
            }
        }

        stage('Docker Run') {
            steps {
                sh '''
                    docker rm -f task6-zomato-container 2>/dev/null || true

                    docker run -d \
                    --name task6-zomato-container \
                    -p 3000:3000 \
                    task6-zomato

                    echo "===== Running Container ====="
                    docker ps --filter name=task6-zomato-container
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'trivy-fs.txt,trivy-image.txt,**/dependency-check-report.xml',
                allowEmptyArchive: true
            )

            echo "Pipeline finished: ${currentBuild.currentResult}"
        }

        success {
            echo '''
            ==========================================
            TASK 6 PIPELINE SUCCESSFUL
            ==========================================
            Git Clone              : SUCCESS
            SonarQube Analysis     : SUCCESS
            NPM Dependencies       : SUCCESS
            OWASP Dependency Check : SUCCESS
            Trivy File Scan        : SUCCESS
            Docker Build           : SUCCESS
            Trivy Image Scan       : SUCCESS
            Docker Deployment      : SUCCESS
            ==========================================
            '''
        }

        failure {
            echo '''
            ==========================================
            TASK 6 PIPELINE FAILED
            Check the stage immediately above this message.
            ==========================================
            '''
        }
    }
}
